<!DOCTYPE html>
<html lang="en" class="h-full bg-zinc-50">
<head>
  <title><%= content_for(:title) || "Macron CMS" %></title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <%= stylesheet_link_tag "macron/cms/application", media: "all" %>
  <%= yield :head %>
</head>
<body class="h-full min-h-screen text-zinc-900 antialiased flex bg-zinc-50">
  <!-- Sidebar Navigation -->
  <aside class="w-64 shrink-0 bg-white border-r border-zinc-200 flex flex-col justify-between min-h-screen">
    <div>
      <!-- Brand Logo / Title -->
      <div class="h-16 flex items-center gap-3 px-6 border-b border-zinc-200">
        <div class="w-8 h-8 rounded-lg bg-zinc-900 text-white flex items-center justify-center font-bold text-sm tracking-wide shadow-sm">
          M
        </div>
        <div>
          <span class="font-bold text-zinc-900 text-base tracking-tight">MacronCMS</span>
          <span class="block text-[10px] font-mono uppercase tracking-wider text-zinc-600 font-semibold">Engine Admin</span>
        </div>
      </div>

      <!-- Navigation Links -->
      <nav class="p-4 space-y-1" aria-label="Sidebar">
        <% is_dashboard = current_page?(root_path) %>
        <%= link_to root_path, class: cms_nav_link_classes(is_dashboard) do %>
          <svg class="w-5 h-5 <%= is_dashboard ? 'text-white' : 'text-zinc-500' %>" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 0 1 6 3.75h2.25A2.25 2.25 0 0 1 10.5 6v2.25a2.25 2.25 0 0 1-2.25 2.25H6a2.25 2.25 0 0 1-2.25-2.25V6ZM3.75 15.75A2.25 2.25 0 0 1 6 13.5h2.25a2.25 2.25 0 0 1 2.25 2.25V18a2.25 2.25 0 0 1-2.25 2.25H6A2.25 2.25 0 0 1 3.75 18v-2.25ZM13.5 6a2.25 2.25 0 0 1 2.25-2.25H18A2.25 2.25 0 0 1 20.25 6v2.25A2.25 2.25 0 0 1 18 10.5h-2.25a2.25 2.25 0 0 1-2.25-2.25V6ZM13.5 15.75a2.25 2.25 0 0 1 2.25-2.25H18a2.25 2.25 0 0 1 2.25 2.25V18A2.25 2.25 0 0 1 18 20.25h-2.25A2.25 2.25 0 0 1 13.5 18v-2.25Z" />
          </svg>
          Dashboard
        <% end %>

        <% is_articles = controller_name == "articles" %>
        <%= link_to articles_path, class: cms_nav_link_classes(is_articles) do %>
          <svg class="w-5 h-5 <%= is_articles ? 'text-white' : 'text-zinc-500' %>" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
          </svg>
          Articles
        <% end %>
      </nav>
    </div>

    <!-- Bottom Sidebar (Host App Link) -->
    <div class="p-4 border-t border-zinc-200">
      <% host_root = main_app.respond_to?(:root_path) ? main_app.root_path : "/" %>
      <%= link_to host_root, class: "flex items-center justify-between px-3 py-2 text-sm text-zinc-600 hover:text-zinc-900 rounded-lg hover:bg-zinc-100 transition-colors group" do %>
        <span class="flex items-center gap-2">
          <svg class="w-4 h-4 text-zinc-600 group-hover:text-zinc-700" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
          </svg>
          View Main Site
        </span>
        <svg class="w-4 h-4 text-zinc-600 group-hover:text-zinc-700" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
        </svg>
      <% end %>
    </div>
  </aside>

  <!-- Main Layout Area -->
  <div class="flex-1 flex flex-col min-w-0 min-h-screen">
    <!-- Top Header -->
    <header class="h-16 bg-white border-b border-zinc-200 px-6 sm:px-8 flex items-center justify-between shrink-0">
      <div class="flex items-center gap-2 text-sm text-zinc-500">
        <span>MacronCMS</span>
        <span>/</span>
        <span class="font-medium text-zinc-900"><%= content_for(:header_title) || "Overview" %></span>
      </div>

      <div class="flex items-center gap-4">
        <!-- Admin Badge -->
        <span class="inline-flex items-center rounded-full bg-zinc-100 px-2.5 py-0.5 text-xs font-semibold text-zinc-800 ring-1 ring-inset ring-zinc-300">
          Admin
        </span>

        <!-- User Info & Sign Out -->
        <div class="flex items-center gap-3 pl-4 border-l border-zinc-200">
          <% current_admin = cms_current_user %>
          <span class="text-sm font-medium text-zinc-700">
            <%= cms_user_display_name(current_admin) %>
          </span>

          <% if main_app.respond_to?(:destroy_user_session_path) %>
            <%= button_to "Sign out", main_app.destroy_user_session_path, method: :delete, class: "text-xs font-medium text-zinc-500 hover:text-zinc-900 transition-colors ml-1 cursor-pointer" %>
          <% end %>
        </div>
      </div>
    </header>

    <!-- Flash Notifications -->
    <div class="max-w-7xl w-full mx-auto px-6 sm:px-8 pt-6">
      <% if notice.present? %>
        <div class="p-4 mb-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm flex items-center gap-3">
          <svg class="w-5 h-5 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
          </svg>
          <span class="font-medium"><%= notice %></span>
        </div>
      <% end %>

      <% if alert.present? %>
        <div class="p-4 mb-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-sm flex items-center gap-3">
          <svg class="w-5 h-5 text-rose-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z" />
          </svg>
          <span class="font-medium"><%= alert %></span>
        </div>
      <% end %>
    </div>

    <!-- Main Content Canvas -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-6 sm:px-8 pb-12">
      <%= yield %>
    </main>
  </div>
</body>
</html>
