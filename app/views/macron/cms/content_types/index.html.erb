<% content_for :title, "Content Types - Macron CMS" %>
<% cms_breadcrumb "Content Types" %>

<div class="space-y-6">
  <!-- Page Header -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-zinc-200 pb-6">
    <div>
      <div class="flex items-center gap-3">
        <h1 class="text-2xl font-bold tracking-tight text-zinc-900 sm:text-3xl">Content Types</h1>
        <span class="inline-flex items-center rounded-full bg-zinc-100 px-2.5 py-0.5 text-xs font-semibold text-zinc-800 ring-1 ring-inset ring-zinc-300">
          <%= pluralize(@content_types.count, "content type") %>
        </span>
      </div>
      <p class="mt-1 text-sm text-zinc-500">Manage and inspect imported content type schemas and field definitions.</p>
    </div>
  </div>

  <% if @content_types.any? %>
    <div class="overflow-hidden rounded-xl border border-zinc-200 bg-white shadow-xs">
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-zinc-200 text-left text-sm">
          <thead class="bg-zinc-50 text-zinc-700 font-semibold text-xs uppercase tracking-wider">
            <tr>
              <th scope="col" class="px-6 py-3.5">Name</th>
              <th scope="col" class="px-6 py-3.5">Fields Summary</th>
              <th scope="col" class="px-6 py-3.5">Convertible To</th>
              <th scope="col" class="px-6 py-3.5">Featured Image</th>
              <th scope="col" class="px-6 py-3.5">Created At</th>
              <th scope="col" class="px-6 py-3.5 text-right">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-zinc-200">
            <% @content_types.each do |content_type| %>
              <%
                field_list = if content_type.fields.is_a?(Array)
                  content_type.fields
                elsif content_type.fields.is_a?(Hash) && content_type.fields.present?
                  [content_type.fields]
                else
                  []
                end
              %>
              <tr class="hover:bg-zinc-50/80 transition-colors">
                <td class="px-6 py-4 font-semibold text-zinc-900 whitespace-nowrap">
                  <div class="flex items-center gap-2">
                    <%= link_to content_type.name, content_type_path(content_type), class: "hover:underline font-mono text-sm" %>
                  </div>
                </td>
                <td class="px-6 py-4 text-zinc-600 text-xs">
                  <% if field_list.any? %>
                    <div class="flex flex-wrap gap-1.5">
                      <% field_list.each do |field| %>
                        <span class="inline-flex items-center rounded-md bg-zinc-100 px-2 py-0.5 font-mono text-[11px] text-zinc-700 ring-1 ring-inset ring-zinc-200">
                          <%= field["name"] || field[:name] || "field" %>
                          <span class="text-zinc-600 ml-1">(<%= field["kind"] || field[:kind] || "any" %>)</span>
                        </span>
                      <% end %>
                    </div>
                  <% else %>
                    <span class="text-zinc-600 italic">No fields defined</span>
                  <% end %>
                </td>
                <td class="px-6 py-4 text-zinc-600 text-xs">
                  <% convertible_names = content_type.normalized_convertible_to %>
                  <% if convertible_names.any? %>
                    <div class="flex flex-wrap gap-1.5">
                      <% convertible_names.each do |target_name| %>
                        <% target_ct = (@content_types_by_name || {})[target_name] %>
                        <% if target_ct %>
                          <%= link_to target_name, content_type_path(target_ct), class: "inline-flex items-center rounded-md bg-emerald-50 px-2 py-0.5 font-mono text-[11px] font-medium text-emerald-800 ring-1 ring-inset ring-emerald-200 hover:bg-emerald-100 transition-colors" %>
                        <% else %>
                          <span class="inline-flex items-center rounded-md bg-zinc-100 px-2 py-0.5 font-mono text-[11px] text-zinc-700 ring-1 ring-inset ring-zinc-200">
                            <%= target_name %>
                          </span>
                        <% end %>
                      <% end %>
                    </div>
                  <% else %>
                    <span class="text-zinc-400">—</span>
                  <% end %>
                </td>
                <td class="px-6 py-4 text-zinc-600 text-xs whitespace-nowrap">
                  <% if content_type.featured_image? %>
                    <span class="inline-flex items-center rounded-md bg-emerald-50 px-2 py-0.5 font-mono text-[11px] font-medium text-emerald-800 ring-1 ring-inset ring-emerald-200">
                      Yes
                    </span>
                  <% else %>
                    <span class="text-zinc-400">—</span>
                  <% end %>
                </td>
                <td class="px-6 py-4 text-zinc-500 text-xs whitespace-nowrap">
                  <%= content_type.created_at.strftime("%b %d, %Y") rescue "—" %>
                </td>
                <td class="px-6 py-4 text-right text-xs font-medium whitespace-nowrap">
                  <%= link_to "Show", content_type_path(content_type), class: "text-zinc-700 hover:text-zinc-900 hover:underline" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% else %>
    <div class="rounded-xl border border-dashed border-zinc-300 bg-white p-12 text-center">
      <svg class="mx-auto h-12 w-12 text-zinc-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6.429 9.75 2.25 12l4.179 2.25m0-4.5 5.571 3 5.571-3m-11.142 0L2.25 7.5 12 2.25l9.75 5.25-4.179 2.25m0 0L21.75 12l-4.179 2.25m0 0 4.179 2.25L12 21.75 2.25 16.5l4.179-2.25m11.142 0-5.571 3-5.571-3" />
      </svg>
      <h3 class="mt-2 text-sm font-semibold text-zinc-900">No content types found</h3>
      <p class="mt-1 text-sm text-zinc-500">Import YAML content types from your application by running the import task.</p>
      <div class="mt-4">
        <code class="rounded-md bg-zinc-100 px-3 py-1.5 font-mono text-xs text-zinc-800 ring-1 ring-inset ring-zinc-200">
          bin/rails macron:cms:import_content_types
        </code>
      </div>
    </div>
  <% end %>
</div>
