<% content_for :title, "Dashboard - Macron CMS" %>
<% content_for :header_title, "Dashboard" %>

<div class="space-y-8">
  <!-- Page Header -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-zinc-200 pb-6">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-zinc-900 sm:text-3xl">CMS Dashboard</h1>
      <p class="mt-1 text-sm text-zinc-500">Overview of your published content, system health, and quick actions.</p>
    </div>
    <div class="flex items-center gap-3">
      <%= link_to new_article_path, class: "inline-flex items-center gap-2 rounded-lg bg-zinc-900 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-zinc-800 transition-colors" do %>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
        </svg>
        New Article
      <% end %>
    </div>
  </div>

  <!-- Metric Stat Cards -->
  <div class="grid grid-cols-1 gap-5 sm:grid-cols-3">
    <!-- Stat 1: Total Articles -->
    <div class="overflow-hidden rounded-xl bg-white p-6 border border-zinc-200 shadow-xs">
      <div class="flex items-center justify-between">
        <dt class="truncate text-sm font-medium text-zinc-500">Total Articles</dt>
        <span class="rounded-md bg-zinc-100 p-2 text-zinc-700">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
          </svg>
        </span>
      </div>
      <dd class="mt-3 text-3xl font-bold tracking-tight text-zinc-900"><%= @articles_count %></dd>
      <p class="mt-1 text-xs text-zinc-500">Managed via Macron CMS</p>
    </div>

    <!-- Stat 2: Engine Version -->
    <div class="overflow-hidden rounded-xl bg-white p-6 border border-zinc-200 shadow-xs">
      <div class="flex items-center justify-between">
        <dt class="truncate text-sm font-medium text-zinc-500">Engine Version</dt>
        <span class="rounded-md bg-zinc-100 p-2 text-zinc-700">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.324.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 0 1 1.37.49l1.296 2.247a1.125 1.125 0 0 1-.26 1.431l-1.003.827c-.293.24-.438.613-.431.992a6.759 6.759 0 0 1 0 .255c-.007.378.138.75.43.99l1.005.828c.424.35.534.954.26 1.43l-1.298 2.247a1.125 1.125 0 0 1-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.57 6.57 0 0 1-.22.128c-.331.183-.581.495-.644.869l-.213 1.28c-.09.543-.56.941-1.11.941h-2.594c-.55 0-1.02-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 0 1-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 0 1-1.369-.49l-1.297-2.247a1.125 1.125 0 0 1 .26-1.431l1.004-.827c.292-.24.437-.613.43-.992a6.932 6.932 0 0 1 0-.255c.007-.378-.138-.75-.43-.99l-1.004-.828a1.125 1.125 0 0 1-.26-1.43l1.297-2.247a1.125 1.125 0 0 1 1.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.087.22-.128.332-.183.582-.495.644-.869l.214-1.281Z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
          </svg>
        </span>
      </div>
      <dd class="mt-3 text-3xl font-bold tracking-tight text-zinc-900 font-mono">v<%= Macron::Cms::VERSION %></dd>
      <p class="mt-1 text-xs text-zinc-500">Standalone Tailwind Enabled</p>
    </div>

    <!-- Stat 3: Access Guard -->
    <div class="overflow-hidden rounded-xl bg-white p-6 border border-zinc-200 shadow-xs">
      <div class="flex items-center justify-between">
        <dt class="truncate text-sm font-medium text-zinc-500">Access Guard</dt>
        <span class="rounded-md bg-emerald-50 p-2 text-emerald-700">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" />
          </svg>
        </span>
      </div>
      <dd class="mt-3 text-3xl font-bold tracking-tight text-zinc-900">Protected</dd>
      <p class="mt-1 text-xs text-zinc-500">Devise <%= Macron::Cms.configuration.user_class %> (<%= Macron::Cms.configuration.admin_flag %>: true)</p>
    </div>
  </div>

  <!-- Recent Articles Section -->
  <div class="space-y-4">
    <div class="flex items-center justify-between">
      <div>
        <h2 class="text-lg font-semibold text-zinc-900">Recent Articles</h2>
        <p class="text-xs text-zinc-500">Latest content items updated or created in the engine.</p>
      </div>
      <% if @articles_count > 0 %>
        <%= link_to "View all articles &rarr;".html_safe, articles_path, class: "text-sm font-medium text-zinc-700 hover:text-zinc-900 transition-colors" %>
      <% end %>
    </div>

    <% if @recent_articles.any? %>
      <div class="overflow-hidden rounded-xl border border-zinc-200 bg-white shadow-xs">
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-zinc-200 text-left text-sm">
            <thead class="bg-zinc-50 text-zinc-700 font-semibold text-xs uppercase tracking-wider">
              <tr>
                <th scope="col" class="px-6 py-3.5">Title</th>
                <th scope="col" class="px-6 py-3.5">Slug</th>
                <th scope="col" class="px-6 py-3.5">Created</th>
                <th scope="col" class="px-6 py-3.5 text-right">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-zinc-200">
              <% @recent_articles.each do |article| %>
                <tr class="hover:bg-zinc-50/80 transition-colors">
                  <td class="px-6 py-4 font-medium text-zinc-900 whitespace-nowrap">
                    <%= link_to article.title, article_path(article), class: "hover:underline font-semibold" %>
                  </td>
                  <td class="px-6 py-4 text-zinc-500 font-mono text-xs whitespace-nowrap">
                    <%= article.slug %>
                  </td>
                  <td class="px-6 py-4 text-zinc-500 text-xs whitespace-nowrap">
                    <%= article.created_at.strftime("%b %d, %Y") %>
                  </td>
                  <td class="px-6 py-4 text-right text-xs font-medium space-x-3 whitespace-nowrap">
                    <% if main_app.respond_to?(:article_path) %>
                      <%= link_to "Public View", main_app.article_path(article), class: "text-zinc-600 hover:text-zinc-900 hover:underline", target: "_blank", rel: "noopener" %>
                    <% end %>
                    <%= link_to "Edit", edit_article_path(article), class: "text-zinc-700 hover:text-zinc-900 hover:underline" %>
                    <%= button_to "Delete", article_path(article), method: :delete, data: { turbo_confirm: "Are you sure you want to delete this article?" }, class: "inline text-rose-600 hover:text-rose-800 hover:underline cursor-pointer" %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    <% else %>
      <div class="rounded-xl border border-dashed border-zinc-300 bg-white p-12 text-center">
        <svg class="mx-auto h-12 w-12 text-zinc-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
        </svg>
        <h3 class="mt-2 text-sm font-semibold text-zinc-900">No articles yet</h3>
        <p class="mt-1 text-sm text-zinc-500">Get started by creating your very first article.</p>
        <div class="mt-6">
          <%= link_to new_article_path, class: "inline-flex items-center gap-2 rounded-lg bg-zinc-900 px-3.5 py-2 text-sm font-semibold text-white shadow-sm hover:bg-zinc-800 transition-colors" do %>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
            </svg>
            Create First Article
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
