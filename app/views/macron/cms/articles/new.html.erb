<% content_for :title, "New Article - Macron CMS" %>
<% content_for :header_title, "Articles / New" %>

<div class="max-w-2xl space-y-6">
  <!-- Breadcrumb & Back Link -->
  <nav class="flex items-center gap-2 text-sm text-zinc-500">
    <%= link_to "Articles", articles_path, class: "hover:text-zinc-900 transition-colors" %>
    <span>/</span>
    <span class="font-medium text-zinc-900">New Article</span>
  </nav>

  <div class="border-b border-zinc-200 pb-4">
    <h1 class="text-2xl font-bold tracking-tight text-zinc-900">Create New Article</h1>
    <p class="mt-1 text-sm text-zinc-500">Enter content details to register a new article within Macron CMS.</p>
  </div>

  <div class="rounded-xl border border-zinc-200 bg-white p-6 sm:p-8 shadow-xs">
    <%= render "form", article: @article %>
  </div>
</div>
