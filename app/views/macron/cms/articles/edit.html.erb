<% content_for :title, "Edit Article - Macron CMS" %>
<% cms_breadcrumb "Articles", articles_path %>
<% cms_breadcrumb @article.title, article_path(@article) %>
<% cms_breadcrumb "Edit" %>

<div class="max-w-2xl space-y-6">
  <div class="border-b border-zinc-200 pb-4">
    <h1 class="text-2xl font-bold tracking-tight text-zinc-900">Edit Article</h1>
    <p class="mt-1 text-sm text-zinc-500">Modify article information and update URL identifiers.</p>
  </div>

  <div class="rounded-xl border border-zinc-200 bg-white p-6 sm:p-8 shadow-xs">
    <%= render "form", article: @article %>
  </div>
</div>
