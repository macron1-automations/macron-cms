<div class="max-w-3xl mx-auto px-4 sm:px-6 py-12 sm:py-16">
  <!-- Header -->
  <header class="pb-8 mb-8 border-b border-zinc-200 flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">
    <div>
      <h1 class="text-3xl font-bold tracking-tight text-zinc-900 sm:text-4xl">Articles</h1>
      <p class="mt-2 text-sm text-zinc-500">Curated writing, stories, and technical guides.</p>
    </div>
    <span class="inline-flex self-start sm:self-auto items-center rounded-full bg-zinc-100 px-3 py-1 text-xs font-medium text-zinc-700 ring-1 ring-inset ring-zinc-200">
      <%= pluralize(@pagy ? @pagy.count : @articles.count, "article") %>
    </span>
  </header>

  <!-- Articles Stream -->
  <% if @articles.any? %>
    <ul role="list" class="divide-y divide-zinc-200">
      <% @articles.each do |article| %>
        <li class="group py-6 flex items-start justify-between gap-4 sm:gap-6 transition-colors">
          <% if article.featured_image.present? %>
            <%= link_to article_path(article), class: "shrink-0 block overflow-hidden rounded-lg border border-zinc-200 bg-zinc-100 hover:opacity-90 transition-opacity" do %>
              <%= image_tag article.featured_image, class: "w-20 h-20 sm:w-24 sm:h-24 object-cover", alt: article.title, loading: "lazy" %>
            <% end %>
          <% end %>

          <div class="min-w-0 flex-1">
            <h2 class="text-lg font-semibold text-zinc-900 group-hover:text-zinc-600 transition-colors">
              <%= link_to article.title, article_path(article), class: "hover:underline" %>
            </h2>
            <% if article.seo_description.present? %>
              <p class="mt-1 text-sm text-zinc-500 line-clamp-2 leading-relaxed">
                <%= article.seo_description %>
              </p>
            <% end %>
          </div>

          <time datetime="<%= (article.published_at || article.created_at).iso8601 %>" class="shrink-0 text-sm text-zinc-500 font-mono text-right whitespace-nowrap pt-0.5">
            <%= (article.published_at || article.created_at).strftime("%b %d, %Y") %>
          </time>
        </li>
      <% end %>
    </ul>

    <!-- Pagination -->
    <% if @pagy && @pagy.pages > 1 %>
      <nav aria-label="Pagination" class="mt-10 pt-6 border-t border-zinc-200 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <p class="text-xs text-zinc-500">
          Showing <span class="font-medium text-zinc-900"><%= @pagy.from %></span> to <span class="font-medium text-zinc-900"><%= @pagy.to %></span> of <span class="font-medium text-zinc-900"><%= @pagy.count %></span> articles
        </p>

        <div class="inline-flex items-center gap-1">
          <% if @pagy.previous %>
            <%= link_to @pagy.page_url(@pagy.previous), class: "inline-flex items-center gap-1 rounded-lg border border-zinc-300 bg-white px-3 py-1.5 text-xs font-semibold text-zinc-700 shadow-2xs hover:bg-zinc-50 transition-colors" do %>
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
              </svg>
              Previous
            <% end %>
          <% else %>
            <span class="inline-flex items-center gap-1 rounded-lg border border-zinc-200 bg-zinc-50 px-3 py-1.5 text-xs font-semibold text-zinc-400 cursor-not-allowed">
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
              </svg>
              Previous
            </span>
          <% end %>

          <div class="hidden sm:inline-flex items-center gap-1 mx-1">
            <% (1..@pagy.pages).each do |p| %>
              <% if p == @pagy.page %>
                <span aria-current="page" class="inline-flex items-center justify-center w-8 h-8 rounded-lg bg-zinc-900 text-xs font-semibold text-white">
                  <%= p %>
                </span>
              <% else %>
                <%= link_to p, @pagy.page_url(p), class: "inline-flex items-center justify-center w-8 h-8 rounded-lg border border-zinc-300 bg-white text-xs font-semibold text-zinc-700 shadow-2xs hover:bg-zinc-50 transition-colors" %>
              <% end %>
            <% end %>
          </div>

          <% if @pagy.next %>
            <%= link_to @pagy.page_url(@pagy.next), class: "inline-flex items-center gap-1 rounded-lg border border-zinc-300 bg-white px-3 py-1.5 text-xs font-semibold text-zinc-700 shadow-2xs hover:bg-zinc-50 transition-colors" do %>
              Next
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
              </svg>
            <% end %>
          <% else %>
            <span class="inline-flex items-center gap-1 rounded-lg border border-zinc-200 bg-zinc-50 px-3 py-1.5 text-xs font-semibold text-zinc-400 cursor-not-allowed">
              Next
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
              </svg>
            </span>
          <% end %>
        </div>
      </nav>
    <% end %>
  <% else %>
    <div class="text-center py-16 px-4 rounded-xl border border-dashed border-zinc-300">
      <p class="text-sm text-zinc-500">No articles published yet.</p>
    </div>
  <% end %>
</div>
