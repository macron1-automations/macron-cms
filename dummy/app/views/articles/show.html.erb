<% cms_seo_meta(@article) %>
<% if cms_article_background_style(@article).present? %>
  <% content_for :body_style, cms_article_background_style(@article) %>
<% end %>

<div class="max-w-4xl mx-auto px-4 sm:px-6 py-12 sm:py-16">
  <!-- Back navigation -->
  <nav class="mb-8">
    <%= link_to root_path, class: "inline-flex items-center gap-1.5 text-sm font-medium text-zinc-600 hover:text-zinc-900 transition-colors" do %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
      </svg>
      Back to articles
    <% end %>
  </nav>

  <!-- Article Header -->
  <header class="pb-8 mb-8 border-b border-zinc-200">
    <div class="flex items-center gap-3 text-sm <%= @article.text_color.present? ? 'opacity-70' : 'text-zinc-500' %> mb-3 font-mono" style="<%= "color: #{@article.text_color};" if @article.text_color.present? %>">
      <time datetime="<%= @article.created_at.iso8601 %>">
        <%= @article.created_at.strftime("%B %d, %Y") %>
      </time>
    </div>
    <h1 class="text-3xl font-bold tracking-tight <%= 'text-zinc-900' unless @article.text_color.present? %> sm:text-4xl lg:text-5xl" style="<%= "color: #{@article.text_color};" if @article.text_color.present? %>">
      <%= @article.title %>
    </h1>
  </header>

  <!-- Article Content Widgets -->
  <div class="space-y-4">
    <%= cms_render_article_contents(@article) %>
  </div>
</div>
