<% if embed_url.present? %>
  <div class="my-6 overflow-hidden rounded-xl border border-zinc-200 bg-white shadow-xs">
    <iframe
      src="<%= embed_url %>"
      class="w-full h-96 sm:h-[450px] border-0"
      sandbox="allow-scripts allow-same-origin allow-popups"
      loading="lazy"
      title="Embedded HTML content"
    ></iframe>
  </div>
<% end %>
