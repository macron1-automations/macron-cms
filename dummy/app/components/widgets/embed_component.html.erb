<% if embed_html.present? %>
  <div class="my-6 <%= container_classes %> overflow-hidden rounded-xl border border-zinc-200 bg-white shadow-xs">
    <iframe
      srcdoc="<%= embed_html %>"
      class="w-full <%= height_class %> border-0"
      sandbox="allow-scripts allow-same-origin allow-popups"
      loading="lazy"
      title="Embedded HTML content"
    ></iframe>
  </div>
<% end %>
